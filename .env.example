# Prontuário — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) e preencha. Na Vercel, cadastre em
# Project Settings → Environment Variables (Production e Preview).
# Nunca comite valores reais.

# Neon (aws-sa-east-1). Conexão COM pooler — usada pelo app.
DATABASE_URL=
# Neon. Conexão DIRETA (sem pooler) — usada por prisma migrate deploy e pelo backup.
DIRECT_URL=

# Auth.js v5. 32 bytes aleatórios em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use um valor diferente em produção e em desenvolvimento.
AUTH_SECRET=
# Só em desenvolvimento (http://localhost:3000). Na Vercel, deixe vazio: o Auth.js
# detecta a URL do deploy sozinho.
AUTH_URL=

# Allowlist rígida: e-mails que podem entrar, separados por vírgula. É o kill
# switch — tirar um e-mail daqui revoga o acesso na hora, inclusive de sessões abertas.
ALLOWED_EMAILS=

# Organização usada para auditar tentativas de login sem usuário.
DEFAULT_ORG_SLUG=suporte

# Só em desenvolvimento local. O código formata tudo no fuso de São Paulo
# explicitamente; na Vercel não é preciso (nem permitido) definir TZ.
TZ=America/Sao_Paulo
